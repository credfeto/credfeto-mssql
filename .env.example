# Copy this file to .env and fill in the required values before running install or update.

# SQL Server SA password — must meet SQL Server complexity requirements
# (at least 8 characters, including uppercase, lowercase, digit, and symbol)
SA_PASSWORD=

# Watchtower update check schedule — 6-field cron expression with seconds first
# (seconds minutes hours day-of-month month day-of-week). Defaults to daily at 06:30.
# WATCHTOWER_SCHEDULE=0 30 6 * * *
